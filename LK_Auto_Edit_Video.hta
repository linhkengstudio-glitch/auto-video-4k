<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>LK_Auto_Edit_Video — Trình Cài Đặt &amp; Khởi Động</title>
<hta:application
  id="LKAutoEditVideoHTA"
  applicationname="LK_Auto_Edit_Video"
  border="thin"
  borderstyle="normal"
  caption="yes"
  contextmenu="no"
  maximizebutton="no"
  minimizebutton="no"
  navigable="no"
  scroll="no"
  selection="no"
  showintaskbar="yes"
  singleinstance="yes"
  sysmenu="yes"
  version="4.5.0"
  windowstate="normal"
/>
<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    user-select: none;
  }
  body {
    font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    background: #070b14;
    color: #f8fafc;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding: 24px 28px;
  }
  .card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 16px;
    padding: 22px 24px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.75);
  }
  .header {
    display: flex;
    align-items: center;
    margin-bottom: 18px;
  }
  .logo-box {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    border: 2px solid #f59e0b;
    overflow: hidden;
    margin-right: 16px;
    flex-shrink: 0;
    background: #020617;
  }
  .logo-box img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .title-main {
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.4px;
  }
  .title-main span {
    color: #38bdf8;
  }
  .subtitle {
    font-size: 12px;
    color: #94a3b8;
    margin-top: 4px;
  }
  .pct-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
  }
  .status-text {
    font-size: 13px;
    font-weight: 600;
    color: #e2e8f0;
  }
  .pct-num {
    font-size: 24px;
    font-weight: 800;
    color: #38bdf8;
  }
  .bar-bg {
    width: 100%;
    height: 16px;
    background: #020617;
    border: 1px solid #1e293b;
    border-radius: 999px;
    overflow: hidden;
    padding: 2px;
  }
  .bar-fill {
    width: 0%;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #0ea5e9 0%, #10b981 55%, #f59e0b 100%);
    transition: width 0.08s linear;
  }
  .footer-note {
    margin-top: 14px;
    font-size: 11px;
    color: #64748b;
    text-align: center;
  }
</style>
</head>
<body>
  <div class="card">
    <div class="header">
      <div class="logo-box">
        <img src="data:image/png;base64," alt="LK 4K" />
      </div>
      <div>
        <div class="title-main">LK_AUTO_EDIT_<span>VIDEO</span></div>
        <div class="subtitle">B&#7843;n v4.5.0 &bull; &#272;&#7891;ng b&#7897; GitHub T&#7913;c Th&#236; &amp; M&#7903; Kh&#243;a Ch&#7885;n Th&#432; M&#7909;c</div>
      </div>
    </div>

    <div class="pct-row">
      <div id="status-label" class="status-text">&#272;ang kh&#7903;i t&#7841;o LK_Auto_Edit_Video...</div>
      <div id="pct-label" class="pct-num">0%</div>
    </div>

    <div class="bar-bg">
      <div id="bar-fill" class="bar-fill"></div>
    </div>

    <div id="detail-label" class="footer-note">
      H&#7879; th&#7889;ng t&#7921; &#273;&#7897;ng c&#7853;p nh&#7853;t t&#7915; GitHub, g&#7855;n Logo LK v&#224; m&#7903; Full M&#224;n H&#236;nh khi &#273;&#7841;t 100%
    </div>
  </div>

<script type="text/javascript">
  try {
    window.resizeTo(560, 275);
    window.moveTo(Math.max(0, Math.floor((screen.availWidth - 560) / 2)), Math.max(0, Math.floor((screen.availHeight - 275) / 2)));
  } catch (e) {}

  var BUNDLED_VERSION = "v4.5.0";
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var wsh = new ActiveXObject("WScript.Shell");

  function getSourceFolder() {
    try {
      var p = unescape(document.location.pathname);
      if (p.charAt(0) === "/" && p.charAt(2) === ":") {
        p = p.substring(1);
      }
      p = p.replace(/\//g, "\\");
      var dir = fso.GetParentFolderName(p);
      if (dir && fso.FolderExists(dir)) {
        return dir;
      }
    } catch (e) {}
    return wsh.CurrentDirectory;
  }

  var srcDir = getSourceFolder();
  var localAppData = wsh.ExpandEnvironmentStrings("%LOCALAPPDATA%");
  var appDir = localAppData + "\\LunKengAutoVideo4K";
  var htmlTarget = appDir + "\\auto_video_editor.html";
  var icoTarget = appDir + "\\Lun_Keng_4K_Logo_v32.ico";
  var htaTarget = appDir + "\\LK_Auto_Edit_Video.hta";
  var verFile = appDir + "\\installed_version.txt";
  var githubRepo = "linhkengstudio-glitch/auto-video-4k";
  var githubBase = "https://raw.githubusercontent.com/" + githubRepo + "/main";

  function parseVerArray(vStr) {
    var clean = String(vStr || "").replace(/[^0-9.]/g, "");
    var parts = clean.split(".");
    var res = [];
    for (var i = 0; i < parts.length; i++) {
      res.push(parseInt(parts[i], 10) || 0);
    }
    return res;
  }

  function isRemoteNewerOrDifferent(remoteVer, localVer) {
    var a = parseVerArray(remoteVer);
    var b = parseVerArray(localVer);
    var len = Math.max(a.length, b.length);
    for (var i = 0; i < len; i++) {
      var av = (i < a.length) ? a[i] : 0;
      var bv = (i < b.length) ? b[i] : 0;
      if (av > bv) return true;
      if (av < bv) return false;
    }
    return false;
  }

  function setProgress(pct, msg, detail) {
    document.getElementById("bar-fill").style.width = pct + "%";
    document.getElementById("pct-label").innerHTML = pct + "%";
    if (msg) document.getElementById("status-label").innerHTML = msg;
    if (detail) document.getElementById("detail-label").innerHTML = detail;
  }

  function step1_CopyLocalFiles() {
    try {
      if (!fso.FolderExists(appDir)) {
        fso.CreateFolder(appDir);
      }
      var filesToCopy = [
        ["auto_video_editor.html", htmlTarget],
        ["Lun_Keng_4K_Logo.ico", icoTarget],
        ["Lun_Keng_4K_Logo.ico", appDir + "\\Lun_Keng_4K_Logo.ico"],
        ["auto_video_studio_4k.py", appDir + "\\auto_video_studio_4k.py"],
        ["LK_Auto_Edit_Video.hta", htaTarget],
        ["Go_Cai_Dat_LK_Auto_Edit_Video.hta", appDir + "\\Go_Cai_Dat_LK_Auto_Edit_Video.hta"],
        ["lk_local_bridge.ps1", appDir + "\\lk_local_bridge.ps1"]
      ];
      var copiedFromBundle = false;
      for (var i = 0; i < filesToCopy.length; i++) {
        var sFile = srcDir + "\\" + filesToCopy[i][0];
        var dFile = filesToCopy[i][1];
        if (fso.FileExists(sFile) && sFile.toLowerCase() !== dFile.toLowerCase()) {
          try {
            fso.CopyFile(sFile, dFile, true);
            copiedFromBundle = true;
          } catch (e2) {}
        }
      }

      // Luôn tự giải nén & ghi mới lk_local_bridge.ps1 vào ổ C để đảm bảo dịch vụ mở cửa sổ chọn thư mục (localhost:48915) hoạt động 100%!
      try {
        var psPath = appDir + "\\lk_local_bridge.ps1";
        var sBridge = srcDir + "\\lk_local_bridge.ps1";
        if (fso.FileExists(sBridge) && sBridge.toLowerCase() !== psPath.toLowerCase()) {
          fso.CopyFile(sBridge, psPath, true);
        } else {
          var xmlDom = new ActiveXObject("MSXML2.DOMDocument.6.0");
          var node = xmlDom.createElement("b64");
          node.dataType = "bin.base64";
          node.text = "";
          var st = new ActiveXObject("ADODB.Stream");
          st.Type = 1;
          st.Open();
          st.Write(node.nodeTypedValue);
          st.SaveToFile(psPath, 2);
          st.Close();
        }
      } catch (eBr) {}

      if (copiedFromBundle || !fso.FileExists(verFile)) {
        var wf = fso.CreateTextFile(verFile, true);
        wf.Write(BUNDLED_VERSION);
        wf.Close();
      }
      try {
        var regKey = "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\LK_Auto_Edit_Video\\";
        wsh.RegWrite(regKey + "DisplayName", "LK_Auto_Edit_Video (Lun Keng Auto Video 4K)", "REG_SZ");
        wsh.RegWrite(regKey + "DisplayIcon", icoTarget + ",0", "REG_SZ");
        wsh.RegWrite(regKey + "DisplayVersion", BUNDLED_VERSION, "REG_SZ");
        wsh.RegWrite(regKey + "Publisher", "Lun Keng Studio", "REG_SZ");
        wsh.RegWrite(regKey + "InstallLocation", appDir, "REG_SZ");
        wsh.RegWrite(regKey + "UninstallString", "mshta.exe \"" + appDir + "\\Go_Cai_Dat_LK_Auto_Edit_Video.hta\"", "REG_SZ");
        wsh.RegWrite(regKey + "NoModify", 1, "REG_DWORD");
        wsh.RegWrite(regKey + "NoRepair", 1, "REG_DWORD");
      } catch (eReg) {}
    } catch (e) {}
  }

  // Tải file từ GitHub bằng curl.exe chuẩn của Windows 10/11 + fallback ADODB.Stream Text Mode (UTF-8) đảm bảo 100% ghi đè thành công xuống ổ C!
  function downloadFileReliable(url, destPath, isTextUtf8) {
    try {
      var tmpPath = destPath + ".tmp_dl";
      if (fso.FileExists(tmpPath)) {
        try { fso.DeleteFile(tmpPath, true); } catch (e0) {}
      }
      // Cách 1: Dùng curl.exe có sẵn trong C:\Windows\System32\curl.exe (hỗ trợ cả file nhị phân .ico lẫn .html cực nhanh)
      var cmd = "curl.exe -sL -H \"Cache-Control: no-cache\" \"" + url + "?t=" + (new Date().getTime()) + "\" -o \"" + tmpPath + "\"";
      wsh.Run(cmd, 0, true);
      if (fso.FileExists(tmpPath) && fso.GetFile(tmpPath).Size > 1000) {
        fso.CopyFile(tmpPath, destPath, true);
        try { fso.DeleteFile(tmpPath, true); } catch (e1) {}
        return true;
      }
    } catch (eCurl) {}

    // Cách 2: Nếu là file văn bản (.html / .hta), dùng ADODB.Stream ở chế độ Text UTF-8 (Type = 2) không bao giờ bị lỗi SafeArray trong JScript!
    if (isTextUtf8) {
      try {
        var xhr = new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");
        xhr.setTimeouts(2500, 2500, 4000, 6000);
        xhr.open("GET", url + "?t=" + (new Date().getTime()), false);
        xhr.setRequestHeader("Cache-Control", "no-cache, no-store, must-revalidate");
        xhr.send();
        if (xhr.status === 200 && xhr.responseText && xhr.responseText.length > 1000) {
          var stream = new ActiveXObject("ADODB.Stream");
          stream.Type = 2; // adTypeText
          stream.Charset = "utf-8";
          stream.Open();
          stream.WriteText(xhr.responseText);
          stream.SaveToFile(destPath, 2); // adSaveCreateOverWrite
          stream.Close();
          return true;
        }
      } catch (eText) {}
    }
    return false;
  }

  function step2_SyncFromGitHub() {
    try {
      var localVer = BUNDLED_VERSION;
      if (fso.FileExists(verFile)) {
        var tf = fso.OpenTextFile(verFile, 1, false);
        localVer = tf.ReadAll();
        tf.Close();
      }

      // Lấy mã commit SHA mới nhất từ GitHub API để vượt qua toàn bộ bộ nhớ đệm 5 phút của raw.githubusercontent.com
      var rawBaseToUse = githubBase;
      try {
        var apiXhr = new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");
        apiXhr.setTimeouts(1500, 1500, 2500, 2500);
        apiXhr.open("GET", "https://api.github.com/repos/" + githubRepo + "/commits/main?t=" + (new Date().getTime()), false);
        apiXhr.setRequestHeader("User-Agent", "LKAutoEditVideo/3.2");
        apiXhr.send();
        if (apiXhr.status === 200 && apiXhr.responseText) {
          var shaMatch = apiXhr.responseText.match(/"sha"\s*:\s*"([0-9a-f]{40})"/i);
          if (shaMatch && shaMatch[1]) {
            rawBaseToUse = "https://raw.githubusercontent.com/" + githubRepo + "/" + shaMatch[1];
          }
        }
      } catch (eSha) {}

      var xhr = new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");
      xhr.setTimeouts(2000, 2000, 3000, 3000);
      xhr.open("GET", rawBaseToUse + "/version_manifest.json?t=" + (new Date().getTime()), false);
      xhr.setRequestHeader("Cache-Control", "no-cache");
      xhr.send();
      if (xhr.status === 200 && xhr.responseText) {
        var verMatch = xhr.responseText.match(/"latest_version"\s*:\s*"([^"]+)"/);
        var remoteVer = verMatch ? verMatch[1] : BUNDLED_VERSION;
        if (isRemoteNewerOrDifferent(remoteVer, localVer)) {
          var okHtml = downloadFileReliable(rawBaseToUse + "/auto_video_editor.html", htmlTarget, true);
          var newVersionedIco = appDir + "\\Lun_Keng_4K_Logo_" + remoteVer.replace(/[^a-zA-Z0-9]/g, "") + ".ico";
          if (downloadFileReliable(rawBaseToUse + "/Lun_Keng_4K_Logo.ico", newVersionedIco, false)) {
            icoTarget = newVersionedIco;
          }
          downloadFileReliable(rawBaseToUse + "/LK_Auto_Edit_Video.hta", htaTarget, true);
          downloadFileReliable(rawBaseToUse + "/lk_local_bridge.ps1", appDir + "\\lk_local_bridge.ps1", true);
          if (okHtml) {
            var wf = fso.CreateTextFile(verFile, true);
            wf.Write(remoteVer);
            wf.Close();
          }
        }
      }
    } catch (e) {}
  }

  function step3_CreateDesktopShortcutWithLogo() {
    try {
      var desks = [];
      var d1 = wsh.SpecialFolders("Desktop");
      if (d1) desks.push(d1);
      var d2 = wsh.ExpandEnvironmentStrings("%USERPROFILE%") + "\\Desktop";
      if (d2 !== d1) desks.push(d2);
      var d3 = wsh.ExpandEnvironmentStrings("%USERPROFILE%") + "\\OneDrive\\Desktop";
      desks.push(d3);

      var shortcutName = "LK_Auto_Edit_Video.lnk";
      var oldName1 = "L\u01B0n Keng Auto Video 4K.lnk";
      var oldName2 = "L\u01B0n Keng Auto Video 4K.url";

      for (var i = 0; i < desks.length; i++) {
        var dFolder = desks[i];
        if (dFolder && fso.FolderExists(dFolder)) {
          try { if (fso.FileExists(dFolder + "\\auto_video_editor.lnk")) fso.DeleteFile(dFolder + "\\auto_video_editor.lnk", true); } catch (e1) {}
          try { if (fso.FileExists(dFolder + "\\auto_video_editor.html.lnk")) fso.DeleteFile(dFolder + "\\auto_video_editor.html.lnk", true); } catch (e2) {}
          try { if (fso.FileExists(dFolder + "\\" + oldName1)) fso.DeleteFile(dFolder + "\\" + oldName1, true); } catch (e3) {}
          try { if (fso.FileExists(dFolder + "\\" + oldName2)) fso.DeleteFile(dFolder + "\\" + oldName2, true); } catch (e4) {}

          var lnkPath = dFolder + "\\" + shortcutName;
          var sc = wsh.CreateShortcut(lnkPath);
          sc.TargetPath = "mshta.exe";
          sc.Arguments = "\"" + htaTarget + "\"";
          sc.WorkingDirectory = appDir;
          sc.IconLocation = icoTarget + ",0";
          sc.WindowStyle = 1;
          sc.Description = "LK_Auto_Edit_Video - Lun Keng Auto Video 4K";
          sc.Save();
        }
      }
      wsh.Run("ie4uinit.exe -show", 0, false);
    } catch (e) {}
  }

  function step4_LaunchStandaloneApp() {
    try {
      // Khởi động cầu nối Windows Native Bridge (127.0.0.1:48915) chạy ngầm để mở hộp thoại chọn thư mục gốc của Windows (không hiện Allow/Don't Allow) và lưu thẳng file Video xuống ổ cứng!
      var bridgeScript = appDir + "\\lk_local_bridge.ps1";
      if (fso.FileExists(bridgeScript)) {
        wsh.Run("powershell.exe -STA -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"" + bridgeScript + "\"", 0, false);
      }
      // Thêm ?v=timestamp để trình duyệt không bao giờ đọc cache cũ, đồng thời cấp profile riêng & mở khóa chọn thư mục trên file:///
      var fileUri = "file:///" + htmlTarget.replace(/\\/g, "/") + "?v=" + (new Date().getTime());
      var profileDir = appDir + "\\AppProfile";
      var winArgs = " --user-data-dir=\"" + profileDir + "\""
                  + " --no-first-run --no-default-browser-check"
                  + " --allow-file-access-from-files"
                  + " --disk-cache-size=1"
                  + " --app=\"" + fileUri + "\""
                  + " --start-maximized --window-position=0,0 --window-size=" + screen.availWidth + "," + screen.availHeight;

      var edgePaths = [
        wsh.ExpandEnvironmentStrings("%ProgramFiles(x86)%") + "\\Microsoft\\Edge\\Application\\msedge.exe",
        wsh.ExpandEnvironmentStrings("%ProgramFiles%") + "\\Microsoft\\Edge\\Application\\msedge.exe",
        wsh.ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\Microsoft\\Edge\\Application\\msedge.exe",
        wsh.ExpandEnvironmentStrings("%ProgramFiles%") + "\\Google\\Chrome\\Application\\chrome.exe",
        wsh.ExpandEnvironmentStrings("%ProgramFiles(x86)%") + "\\Google\\Chrome\\Application\\chrome.exe"
      ];
      for (var i = 0; i < edgePaths.length; i++) {
        if (fso.FileExists(edgePaths[i])) {
          wsh.Run("\"" + edgePaths[i] + "\"" + winArgs, 3, false);
          return;
        }
      }
      wsh.Run("cmd.exe /c start \"\" msedge.exe" + winArgs, 0, false);
    } catch (e) {
      try { wsh.Run("\"" + htmlTarget + "\"", 3, false); } catch (e2) {}
    }
  }

  var currentPct = 0;
  var didStep1 = false;
  var didStep2 = false;
  var didStep3 = false;

  var timer = window.setInterval(function () {
    currentPct += 2;
    if (currentPct > 100) currentPct = 100;

    if (currentPct === 10) {
      setProgress(10, "&#272;ang c&#7853;p nh&#7853;t nh&#226;n LK_Auto_Edit_Video (v4.5.0)...", "Kh&#7903;i t&#7841;o th&#432; m&#7909;c AppData\Local\LunKengAutoVideo4K");
    } else if (currentPct === 24 && !didStep1) {
      didStep1 = true;
      step1_CopyLocalFiles();
      setProgress(24, "&#272;ang &#273;&#7891;ng b&#7897; tr&#7921;c ti&#7871;p b&#7843;n m&#7899;i nh&#7845;t t&#7915; GitHub (0s Cache)...", "Kho ch&#7913;a: linhkengstudio-glitch/auto-video-4k");
    } else if (currentPct === 54 && !didStep2) {
      didStep2 = true;
      step2_SyncFromGitHub();
      setProgress(54, "&#272;ang g&#7855;n Logo LK_Auto_Edit_Video ra m&#224;n h&#236;nh Desktop...", "Thay th&#7871; ho&#224;n to&#224;n bi&#7875;u t&#432;&#7907;ng C&#7889;c C&#7889;c m&#7863;c &#273;&#7883;nh");
    } else if (currentPct === 82 && !didStep3) {
      didStep3 = true;
      step3_CreateDesktopShortcutWithLogo();
      setProgress(82, "&#272;&#227; m&#7903; kh&#243;a Ch&#7885;n Th&#432; M&#7909;c &amp; Live Font Preview! &#272;ang m&#7903; app...", "Kh&#7903;i &#273;&#7897;ng c&#7917;a s&#7893; &#273;&#7897;c l&#7853;p Full M&#224;n H&#236;nh (100%)");
    } else {
      setProgress(currentPct, null, null);
    }

    if (currentPct >= 100) {
      window.clearInterval(timer);
      setProgress(100, "Ho&#224;n t&#7845;t 100%! &#272;ang m&#7903; LK_Auto_Edit_Video v4.5.0...", "Bi&#7875;u t&#432;&#7907;ng LK_Auto_Edit_Video &#273;&#227; s&#7861;n s&#224;ng ngo&#224;i m&#224;n h&#236;nh Desktop!");
      window.setTimeout(function () {
        step4_LaunchStandaloneApp();
        window.setTimeout(function () {
          window.close();
        }, 450);
      }, 300);
    }
  }, 28);
</script>
</body>
</html>
